
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum CampaignStatus { DRAFT QUEUED DISCOVERING FETCHING EXTRACTING ENRICHING VALIDATING COMPLETED PAUSED SOURCE_EXHAUSTED FAILED }
enum EmailStatus { UNKNOWN VALID INVALID DISPOSABLE ROLE_ACCOUNT }
enum OutreachStatus { PENDING SENT DELIVERED OPENED BOUNCED FAILED REPLIED }
enum Channel { EMAIL WHATSAPP PHONE }

model Campaign {
  id String @id @default(cuid())
  name String
  industry String?
  country String?
  city String?
  keywords String[]
  targetCount Int @default(1000)
  status CampaignStatus @default(DRAFT)
  progress Int @default(0)
  discovered Int @default(0)
  extracted Int @default(0)
  valid Int @default(0)
  duplicates Int @default(0)
  invalid Int @default(0)
  enriched Int @default(0)
  currentStage String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs Job[]
  leads Lead[]
  sources DiscoverySource[]
  outreachLogs OutreachLog[]
}

model Job {
  id String @id @default(cuid())
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id])
  status CampaignStatus @default(QUEUED)
  stage String @default("DISCOVERY")
  batchIndex Int @default(0)
  batchSize Int @default(50)
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiscoverySource {
  id String @id @default(cuid())
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id])
  source String
  sourceUrl String
  query String?
  processed Boolean @default(false)
  enriched Boolean @default(false)
  discoveredAt DateTime @default(now())
}

model Lead {
  id String @id @default(cuid())
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  companyName String?
  industry String?
  category String?
  website String?
  domain String?
  email String?
  emailStatus EmailStatus @default(UNKNOWN)
  emailConfidence Int @default(0)
  emailVerifiedAt DateTime?
  phoneRaw String?
  phoneNormalized String?
  whatsappRaw String?
  whatsappNormalized String?
  whatsappDetected Boolean @default(false)
  whatsappUrl String?
  whatsappSourceUrl String?
  country String?
  city String?
  address String?
  linkedinUrl String?
  facebookUrl String?
  instagramUrl String?
  source String?
  sourceUrl String?
  sourceCount Int @default(1)
  leadScore Int @default(0)
  fingerprint String @unique
  firstSeen DateTime @default(now())
  lastSeen DateTime @default(now())
  createdAt DateTime @default(now())
  outreachLogs OutreachLog[]
  tags String[]
}

model EmailTemplate {
  id String @id @default(cuid())
  name String
  subject String
  body String
  variables String[] // e.g. {{companyName}}, {{city}}
  createdAt DateTime @default(now())
}

model WhatsAppTemplate {
  id String @id @default(cuid())
  name String
  message String
  variables String[]
  createdAt DateTime @default(now())
}

model OutreachLog {
  id String @id @default(cuid())
  campaignId String?
  campaign Campaign? @relation(fields: [campaignId], references: [id])
  leadId String
  lead Lead @relation(fields: [leadId], references: [id])
  channel Channel
  templateId String?
  subject String?
  message String?
  status OutreachStatus @default(PENDING)
  sentAt DateTime?
  openedAt DateTime?
  repliedAt DateTime?
  error String?
  createdAt DateTime @default(now())
}

model SystemSetting {
  id String @id @default(cuid())
  key String @unique
  value Json
}
